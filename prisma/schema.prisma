generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DepartmentRole {
  LIDER
  MEMBRO
}

enum AvailabilityRequestStatus {
  PENDENTE
  APROVADA
  RECUSADA
}

model User {
  id                 Int      @id @default(autoincrement())
  name               String   @db.Text
  email              String   @unique @db.Text
  passwordHash       String   @map("password_hash") @db.Text
  isAdmin            Boolean  @default(false) @map("is_admin")
  isActive           Boolean  @default(true) @map("is_active")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships                  DepartmentMembership[]
  createdEntries               ScheduleEntry[]        @relation("EntryCreatedBy")
  assignments                  ScheduleAssignment[]
  availabilityRequests         AvailabilityRequest[]  @relation("AvailabilityRequestUser")
  reviewedAvailabilityRequests AvailabilityRequest[]  @relation("AvailabilityRequestReviewer")
  passwordResetTokens          PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Text
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String   @db.Text
  description String?  @db.Text
  color       String   @default("#64748b") @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships          DepartmentMembership[]
  entries              ScheduleEntry[]
  positions            Position[]
  availabilityRequests AvailabilityRequest[]

  @@map("departments")
}

model Position {
  id           Int      @id @default(autoincrement())
  departmentId Int      @map("department_id")
  name         String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  department  Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  assignments ScheduleAssignment[]

  @@unique([departmentId, name])
  @@index([departmentId])
  @@map("positions")
}

model DepartmentMembership {
  id           Int            @id @default(autoincrement())
  userId       Int            @map("user_id")
  departmentId Int            @map("department_id")
  role         DepartmentRole
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([departmentId])
  @@map("department_memberships")
}

model ScheduleEntry {
  id           Int      @id @default(autoincrement())
  departmentId Int      @map("department_id")
  date         DateTime @db.Date
  time         String?  @db.Text
  title        String?  @db.Text
  note         String?  @db.Text
  createdById  Int      @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  department  Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdBy   User                 @relation("EntryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignments ScheduleAssignment[]

  @@index([departmentId, date])
  @@map("schedule_entries")
}

model ScheduleAssignment {
  id              Int  @id @default(autoincrement())
  scheduleEntryId Int  @map("schedule_entry_id")
  userId          Int  @map("user_id")
  positionId      Int? @map("position_id")

  scheduleEntry ScheduleEntry @relation(fields: [scheduleEntryId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  position      Position?     @relation(fields: [positionId], references: [id], onDelete: SetNull)

  @@unique([scheduleEntryId, userId, positionId])
  @@index([userId])
  @@index([positionId])
  @@map("schedule_assignments")
}

model AvailabilityRequest {
  id           Int                       @id @default(autoincrement())
  userId       Int                       @map("user_id")
  departmentId Int                       @map("department_id")
  date         DateTime                  @db.Date
  reason       String                    @db.Text
  status       AvailabilityRequestStatus @default(PENDENTE)
  reviewedById Int?                      @map("reviewed_by_id")
  reviewedAt   DateTime?                 @map("reviewed_at") @db.Timestamptz(6)
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User       @relation("AvailabilityRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  reviewedBy User?      @relation("AvailabilityRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([departmentId, date])
  @@index([userId])
  @@map("availability_requests")
}
